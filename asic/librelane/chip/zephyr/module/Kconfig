config I2C_WALLY
    bool "Wally I2C master (src/uncore/mcu/i2c_apb.sv)"
    default y
    depends on I2C && DT_HAS_WALLY_I2C_ENABLED
    select PINCTRL
    help
      Single-master driver for the chip's I2C controller; with an interrupt in the devicetree it sleeps while a command
      runs, otherwise it polls.

config WDT_WALLY
    bool "Wally two-stage watchdog (src/uncore/mcu/wdt_apb.sv)"
    default y
    depends on WATCHDOG && DT_HAS_WALLY_WDT_ENABLED
    help
      Driver for the chip's watchdog: the first timeout is a flag, the second one resets the chip.

config COUNTER_WALLY
    bool "Wally timer as a counter, with capture (src/uncore/mcu/timer_apb.sv)"
    default y
    depends on COUNTER && DT_HAS_WALLY_TIMER_ENABLED
    select COUNTER_SUPPORTS_CAPTURE
    help
      Counter API on the chip's general-purpose timer: top value, four alarms and, with COUNTER_CAPTURE, edge capture
      on GPIO0-3.  The PWM API of the same timer is PWM_WALLY.

config PWM_WALLY
    bool "Wally timer as a PWM (src/uncore/mcu/timer_apb.sv)"
    default y
    depends on PWM && COUNTER_WALLY && DT_HAS_WALLY_TIMER_PWM_ENABLED
    select PINCTRL
    help
      PWM outputs on GPIO0-3, a child node of the timer.  Shares its counter and channels with COUNTER_WALLY.

config RTC_WALLY
    bool "Wally real-time counter (src/uncore/mcu/rtc_apb.sv)"
    default y
    depends on RTC && DT_HAS_WALLY_RTC_ENABLED
    help
      RTC API on the chip's real-time counter: seconds since 1970 and one alarm that matches a full date and time.

config GPIO_WALLY
    bool "Wally GPIO with one interrupt line (src/uncore/gpio_apb.sv)"
    default y
    depends on GPIO && DT_HAS_WALLY_GPIO_ENABLED
    help
      The FE310-style GPIO of the chip with edge and level interrupts on every pin through its single PLIC line.
