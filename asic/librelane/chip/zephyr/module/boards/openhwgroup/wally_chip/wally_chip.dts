/dts-v1/;

#include <wally/wally-rv32imac.dtsi>

/ {
        chosen {
                zephyr,console = &uart0;
                zephyr,shell-uart = &uart0;
                zephyr,sram = &sram0;
        };
};

&uart0 {
        status = "okay";
        current-speed = <115200>;
};
