// Included inside package cvw, after cvw_t. Topology is not a cvw_t field.
typedef struct packed {
  int unsigned NCORES;
  bit SHARED_CACHE;
  int unsigned SHARED_CACHE_WORDS;
  bit PRIVATE_DCACHE;
  int unsigned PRIVATE_DCACHE_WORDS;
  int unsigned PRIVATE_DCACHE_LINE_WORDS;
  bit PRIVATE_ICACHE;
  int unsigned PRIVATE_ICACHE_WORDS;
  int unsigned PRIVATE_ICACHE_LINE_WORDS;
  bit CACHE_TO_CACHE;
  bit CACHE_BURSTS;
  bit MESI;
  int unsigned COHERENCE_BANKS;
  bit LOCAL_DCACHE_READS;
  bit LOCAL_DCACHE_WRITES;
} multicore_t;

function automatic bit multicore_power2(input int unsigned value);
  return value > 0 && (value & (value-1)) == 0;
endfunction

function automatic int multicore_config_error(input cvw_t P, input multicore_t M);
  if (!((M.NCORES >= 1) && (M.NCORES <= 4095))) return 1;
  if (!(multicore_power2(M.COHERENCE_BANKS) && ((M.NCORES == 1) || (M.COHERENCE_BANKS == 1) || M.PRIVATE_DCACHE))) return 2;
  if (!((M.NCORES == 1) || (!(M.PRIVATE_ICACHE || M.CACHE_TO_CACHE || M.CACHE_BURSTS || M.MESI || M.LOCAL_DCACHE_READS || M.LOCAL_DCACHE_WRITES)) || M.PRIVATE_DCACHE)) return 3;
  if (!(!((M.NCORES > 1) && M.PRIVATE_DCACHE && M.SHARED_CACHE))) return 4;
  if (!((!M.SHARED_CACHE) || (multicore_power2(M.SHARED_CACHE_WORDS) && (M.SHARED_CACHE_WORDS >= 2)))) return 5;
  if (!((!((M.NCORES > 1) && M.PRIVATE_DCACHE)) || (multicore_power2(M.PRIVATE_DCACHE_WORDS) && multicore_power2(M.PRIVATE_DCACHE_LINE_WORDS) && (M.PRIVATE_DCACHE_WORDS >= ((2 * M.COHERENCE_BANKS) * M.PRIVATE_DCACHE_LINE_WORDS))))) return 6;
  if (!((!((M.NCORES > 1) && M.PRIVATE_DCACHE)) || (multicore_power2(M.PRIVATE_ICACHE_WORDS) && multicore_power2(M.PRIVATE_ICACHE_LINE_WORDS) && (M.PRIVATE_ICACHE_WORDS >= ((2 * M.COHERENCE_BANKS) * M.PRIVATE_ICACHE_LINE_WORDS))))) return 7;
  if (!(((M.NCORES == 1) && (!M.SHARED_CACHE)) || (P.BUS_SUPPORTED && (!P.DTIM_SUPPORTED) && (!P.IROM_SUPPORTED) && (!P.DCACHE_SUPPORTED) && (!P.ICACHE_SUPPORTED) && (!P.BURST_EN)))) return 8;
  if (!((!((M.NCORES > 1) && M.PRIVATE_DCACHE)) || (!(P.ZICBOM_SUPPORTED || P.ZICBOZ_SUPPORTED || P.ZICBOP_SUPPORTED)))) return 9;
  if (!((!(((M.NCORES > 1) && M.PRIVATE_DCACHE) || M.SHARED_CACHE)) || (!P.SVADU_SUPPORTED))) return 10;
  if (!((!(((M.NCORES > 1) && M.PRIVATE_DCACHE) || M.SHARED_CACHE)) || (!P.SVPBMT_SUPPORTED))) return 11;
  if (!(((M.NCORES == 1) && (!M.SHARED_CACHE)) || (P.AHBW == P.XLEN))) return 12;
  return 0;
endfunction

function automatic string multicore_config_message(input int error);
  case (error)
    1: return "NCORES outside the addressable CLINT register range; this is not a verified hart-count limit";
    2: return "Coherence banks require private MSI and a power-of-two count";
    3: return "Private I-cache/local paths require private MSI data caches";
    4: return "Select private MSI data caches or the shared cache, not both";
    5: return "Shared cache requires power-of-two WORDS >= 2";
    6: return "Each coherence bank needs power-of-two private DCACHE capacity and at least two complete lines";
    7: return "Each coherence bank needs power-of-two private ICACHE capacity and at least two complete lines";
    8: return "Multicore requires a shared bus with no private memories/caches or bursts";
    9: return "MSI baseline does not implement cache-maintenance operations";
    10: return "Cached SMP uses software PTE A/D updates (Svade)";
    11: return "Multicore caches use physical RAM attributes; Svpbmt must be disabled";
    12: return "Buffered memory requires AHBW == XLEN";
    default: return "Valid multicore configuration";
  endcase
endfunction

